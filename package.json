{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/ts-base",
  "version": "0.0.5",
  "description": "TypeScript project configuration with hyper-strict tsconfig composition",
  "license": "MIT",
  "author": "Mark Russell <marktheprogrammer17@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ts-base": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "files": [
    "dist",
    "tsconfig",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && pnpm --filter @ts-base/site run typecheck",
    "test": "node --test test/*.test.ts && pnpm --filter @ts-base/site run test",
    "clean": "rm -rf dist .tsbuildinfo",
    "prepare": "npm run build",
    "check:conventions": "conventions check",
    "check:api": "api-report check"
  },
  "sideEffects": false,
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.0",
    "@mark1russell7/conventions": "^0.38.1",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "^5.0.3"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "deepmerge-ts": "^8.0.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "typescript",
    "tsconfig",
    "configuration",
    "strict"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/ts-base.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/ts-base/issues"
  },
  "homepage": "https://github.com/mark1russell7/ts-base#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=11.0.0"
  },
  "conventions": {
    "rules": {
      "cue-preset": {
        "prefix": "../tsconfig/",
        "reason": "ts-base publishes its own set of tsconfig presets (./tsconfig/*.json), apart from @mark1russell7/cue. The site package extends the preset frontend.json of this repository, so each build of the site tests a preset that the repository publishes. A cue preset here would test the wrong presets. The check of the strict options still runs against the preset that it extends."
      }
    }
  }
}
